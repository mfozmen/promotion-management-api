# Copy to .env for local development: cp .env.example .env
# Placeholders only. Never commit a real credential; .env is gitignored.

# --- Application ---------------------------------------------------------
PORT=3000
# Directory the vendor import stream writes to before chunking.
UPLOAD_DIR=./uploads

# --- PostgreSQL ----------------------------------------------------------
# Must match the POSTGRES_* values below, which docker-compose.yml uses.
# Host processes (npm run dev, the tests) reach the container on localhost.
# A container on the compose network uses the service name instead:
#   DATABASE_URL=postgres://promo:promo@postgres:5432/promotion
DATABASE_URL=postgres://promo:promo@localhost:5432/promotion
POSTGRES_USER=promo
POSTGRES_PASSWORD=promo
POSTGRES_DB=promotion
# Nothing derives DATABASE_URL from this, so change both together; startup
# rejects a loopback DATABASE_URL that dials a different port.
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
# One server, two logical databases. The application derives
# redisReadModelUrl and redisQueueUrl from REDIS_URL plus the index below, so
# no maintenance operation on the read model can reach the queue.
# A container on the compose network uses the service name: redis://redis:6379
REDIS_URL=redis://localhost:6379
REDIS_READ_MODEL_DB=0
REDIS_QUEUE_DB=1
# Change together with REDIS_URL, as with POSTGRES_PORT above.
REDIS_PORT=6379

# --- Vendor ingestion (Scenario A) ---------------------------------------
# Target chunk size in bytes (4 MiB, about 40 000 rows); boundaries move
# forward to the next line feed.
INGESTION_CHUNK_BYTES=4194304
# Rows per upsert transaction; at most 5000, well under the bind-parameter limit.
INGESTION_BATCH_SIZE=1000
# Time budget for one chunk invocation before it checkpoints and hands off.
INGESTION_BUDGET_MS=60000
# Chunk claim lease. Must be at least INGESTION_BUDGET_MS so a healthy run
# never loses its claim mid-chunk.
INGESTION_LEASE_MS=90000
# Failures after which a chunk is marked failed. Budget hand-offs do not count.
INGESTION_MAX_FAILURES=3
# Waiting ingestion jobs above which new imports are rejected with 429.
INGESTION_MAX_WAITING=100
