# Copy to .env for local development: cp .env.example .env
# Placeholders only. Never commit a real credential; .env is gitignored.

# --- Application ---------------------------------------------------------
PORT=3000
# Where the vendor import stream writes before chunking.
UPLOAD_DIR=./uploads

# --- PostgreSQL ----------------------------------------------------------
# On the compose network: postgres://promo:promo@postgres:5432/promotion
DATABASE_URL=postgres://promo:promo@localhost:5432/promotion
# The three below must match DATABASE_URL; docker-compose.yml reads them.
POSTGRES_USER=promo
POSTGRES_PASSWORD=promo
POSTGRES_DB=promotion

# --- Redis ---------------------------------------------------------------
# On the compose network: redis://redis:6379
REDIS_URL=redis://localhost:6379
# One server, two logical databases; these must differ (ADR-0003).
REDIS_READ_MODEL_DB=0
REDIS_QUEUE_DB=1

# --- Vendor ingestion (Scenario A) ---------------------------------------
# Target bytes per chunk; boundaries move forward to the next line feed.
INGESTION_CHUNK_BYTES=4194304
# Rows per upsert transaction; at most 5000.
INGESTION_BATCH_SIZE=1000
# Budget for one chunk invocation before it checkpoints and hands off.
INGESTION_BUDGET_MS=60000
# Chunk claim lease; must be at least INGESTION_BUDGET_MS.
INGESTION_LEASE_MS=90000
# Failures after which a chunk is marked failed; budget hand-offs do not count.
INGESTION_MAX_FAILURES=3
# Waiting jobs above which new imports are rejected with 429.
INGESTION_MAX_WAITING=100
