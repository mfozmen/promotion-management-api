# Copy to .env: cp .env.example .env
# Placeholders only; .env is gitignored.

PORT=3100
UPLOAD_DIR=./uploads

# On the compose network: postgres://promo:promo@postgres:5432/promotion
DATABASE_URL=postgres://promo:promo@localhost:5432/promotion
# The three below must match DATABASE_URL; docker-compose.yml reads them.
POSTGRES_USER=promo
POSTGRES_PASSWORD=promo
POSTGRES_DB=promotion

# On the compose network: redis://redis:6379
REDIS_URL=redis://localhost:6379
# Must differ (ADR-0003).
REDIS_READ_MODEL_DB=0
REDIS_QUEUE_DB=1

# A target; boundaries move forward to the next line feed.
INGESTION_CHUNK_BYTES=4194304
# At most 5000.
INGESTION_BATCH_SIZE=1000
INGESTION_BUDGET_MS=60000
# At least INGESTION_BUDGET_MS.
INGESTION_LEASE_MS=90000
INGESTION_MAX_FAILURES=3
# Waiting jobs above which imports are rejected with 429.
INGESTION_MAX_WAITING=100

# How long SIGTERM waits for open connections before closing the queues; 0 exits immediately
SHUTDOWN_TIMEOUT_MS=10000
