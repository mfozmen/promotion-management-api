            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman sale {{$timestamp}}\",\n  \"discountType\": \"percentage\",\n  \"value\": 5000,\n  \"startsAt\": \"2026-09-14T00:00:00.000Z\",\n  \"endsAt\": \"2026-12-31T00:00:00.000Z\",\n  \"category\": \"{{category}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/promotions",
              "host": ["{{baseUrl}}"],
              "path": ["promotions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.collectionVariables.set('promotionId', p.id);",
                  "pm.test('born active, because it was given a target', () => {",
                  "  pm.expect(p.status).to.eql('active');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products/:id — the sale has reached the storefront",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Asynchronous by design. If this still shows the base price, run it again — the write is applied by a worker, not by the request that created the promotion.",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('half the base price, naming the promotion', () => {",
                  "  pm.expect(p.effectivePriceCents).to.eql(Math.round(p.basePriceCents / 2));",
                  "  pm.expect(p.promotion).to.not.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /promotions — a second one on the same target is refused",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "'A product can have at most one active promotion at a time', enforced by a GiST exclusion constraint inside PostgreSQL — which is why eight concurrent writers produce one 201 and seven 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman clash {{$timestamp}}\",\n  \"discountType\": \"fixed\",\n  \"value\": 100,\n  \"startsAt\": \"2026-09-15T00:00:00.000Z\",\n  \"endsAt\": \"2026-10-01T00:00:00.000Z\",\n  \"category\": \"{{category}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/promotions",
              "host": ["{{baseUrl}}"],
              "path": ["promotions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));",
                  "pm.test('the error envelope, not a stack trace', () => {",
                  "  pm.expect(pm.response.json().error).to.have.property('message');",
                  "});",
                  "pm.test('names the target and the window, never the row it collided with', () => {",
                  "  pm.expect(pm.response.json().error.message).to.not.match(/id \\d+/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /promotions — a draft has no target",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman draft {{$timestamp}}\",\n  \"discountType\": \"percentage\",\n  \"value\": 1000,\n  \"startsAt\": \"2026-09-14T00:00:00.000Z\",\n  \"endsAt\": \"2026-12-31T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/promotions",
              "host": ["{{baseUrl}}"],
              "path": ["promotions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.collectionVariables.set('draftId', p.id);",
                  "pm.test('draft until it is assigned', () => pm.expect(p.status).to.eql('draft'));"
