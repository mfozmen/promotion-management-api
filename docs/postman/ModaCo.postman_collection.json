                  "pm.test('every row matches the filter', () => {",
                  "  pm.response.json().items.forEach((p) => pm.expect(p.status).to.eql('active'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /promotions/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/promotions/{{promotionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["promotions", "{{promotionId}}"]
            }
          },
          "event": [
            {
