              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "POST /promotions/:id/cancel",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/promotions/{{promotionId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["promotions", "{{promotionId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('cancelled', () => pm.expect(pm.response.json().status).to.eql('cancelled'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /promotions/:id/cancel — again, and still 200",
          "request": {
            "method": "POST",
            "header": [],
            "description": "Idempotent on purpose: an operator retrying a cancel should not have to tell 'already done' from 'failed'.",
            "url": {
              "raw": "{{baseUrl}}/promotions/{{promotionId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["promotions", "{{promotionId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 Vendor import (Scenario A)",
      "item": [
        {
          "name": "POST /vendor/imports — upload a CSV",
          "request": {
            "method": "POST",
            "header": [],
            "description": "Pick `fixtures/vendor-sample.csv` from this repository for the `file` field, or any CSV with the header `sku,name,category,vendor_price,stock_quantity`.\n\nThe response returns before the rows are processed: the request hashes the file and computes chunk boundaries (50-59 ms on a 22 MB file) and the workers do the rest. A 500 000-row file answered 202 in 834 ms and completed six chunks afterwards.\n\nThe same bytes can only be registered once, ever, and the uniqueness is global rather than per vendor — so a repeat gives 409.",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "vendor", "value": "postman", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/imports",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "imports"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202, or 409 if these exact bytes were registered before', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([202, 409]);",
                  "});",
                  "if (pm.response.code === 202) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('jobId', body.jobId);",
                  "  pm.test('names the job and how many chunks it will take', () => {",
                  "    pm.expect(body).to.have.all.keys('jobId', 'chunksTotal');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /vendor/imports/:id — follow it",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Run this repeatedly. A killed worker resumes its chunk from the last checkpoint, so `rowsProcessed` never double-counts: on a 500 000-row file killed mid-import, the six chunks still summed to exactly 500 000.",
            "url": {
              "raw": "{{baseUrl}}/vendor/imports/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "imports", "{{jobId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const job = pm.response.json();",
                  "pm.test('the counters an operator follows', () => {",
                  "  pm.expect(job).to.include.keys('status', 'chunksTotal', 'chunksDone', 'rowsProcessed', 'rowsRejected');",
                  "});",
                  "pm.test('a status from the state machine, never something else', () => {",
                  "  pm.expect(job.status).to.be.oneOf(['pending', 'running', 'completed', 'failed']);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
